# 复制为 .env 后按需修改；均未设置时使用代码内默认值

# ===== 串口（ESP32 USB 直连）=====
SERIAL_PORT=auto            # auto=自动检测第一个串口；或填 COM3 / /dev/ttyUSB0
SERIAL_BAUDRATE=115200

# ===== 数据库 =====
# sqlite（默认，本地零配置）或 mysql；V2 可平滑迁移
DATABASE_URL=sqlite+aiosqlite:///../database/wildlife.db

# ===== AI 预留（后期提供 Key 后填写）=====
AI_API_KEY=
AI_BASE_URL=

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
